df_grouped = df.groupby('Dni_Aseg_Anonymized').agg(
    P_certificados_cliente=('Dni_Aseg_Anonymized', 'count'),
    Margen_Bruto_Total=('Margen_Bruto_Total_Certificado', 'sum'),
    CAC_Promedio=('CAC_Promedio', 'first')
).reset_index()

# Calcular CLV
