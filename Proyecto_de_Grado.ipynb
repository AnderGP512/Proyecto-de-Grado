    df_sample10.style
    .background_gradient(subset=['CLV'], cmap='Blues')
    .format({
        'Margen_Bruto_Total': '${:,.0f}',
        'CAC_Promedio': '${:,.0f}',
        'CLV': '${:,.0f}'
